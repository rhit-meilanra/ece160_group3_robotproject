void find_LINESTATE() {
  qtrArray.read(sensorValues);

  if ((sensorValues[3] < 1000 || sensorValues[4] < 1000)) {
    LINESTATE = FORWARD;
    run_FORWARD();
  } else if ((sensorValues[5] < 1000 || sensorValues[6] < 1000 || sensorValues[7] < 1000)) {
    LINESTATE = OFF_RIGHT;
    run_SPINCL();
  } else if ((sensorValues[0] < 1000 || sensorValues[1] < 1000 || sensorValues[2] < 1000)) {
    LINESTATE = OFF_LEFT;
    run_SPINCCL();
  } else {
    LINESTATE = LOST;
    run_SPINCL();
  }
  delay(25);
}

void hurdle() {
  if ((sensorValues[0] < 1000) || (sensorValues[7] < 1000) && (counter != 0)) {
    allOn();
    counter += 1;
  } else {
    allOff();
  }

}

void allOff() {

  gpioExt.digitalWrite(LEDPin, LOW);
}

void allOn() {

  gpioExt.digitalWrite(LEDPin, HIGH);
}
